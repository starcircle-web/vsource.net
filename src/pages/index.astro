---
import Base from '../layouts/Base.astro';
import { meta, hero, problem, services, different, forms, contact, pricing, nav, footer } from '../data/site.js';
---
<Base title={meta.title} description={meta.description}>
  <!-- ── NAV ─────────────────────────────────────────────────────── -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" class="brand" aria-label="vsource home">
        <img src="/vsource-mark.svg" alt="" height="34" class="brand-mark" />
        <span class="wordmark">vsource</span>
      </a>
      <nav class="nav-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#contact" class="btn btn-primary nav-cta">Build your team<span class="arrow">→</span></a>
    </div>
  </header>

  <span id="top"></span>

  <!-- ── HERO ────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="funnel" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="kicker reveal">{hero.kicker}</p>
      <h1 class="display hero-headline">
        {hero.headline.map((line, i) => (
          <span class={"reveal" + (i === hero.headline.length - 1 ? " grad-text" : "")} style={`transition-delay:${0.08 + i * 0.09}s`}>{line}</span>
        ))}
      </h1>
      <p class="hero-lede reveal" style="transition-delay:.42s">{hero.lede}</p>
      <div class="hero-cta reveal" style="transition-delay:.52s">
        <a href={hero.ctaPrimary.href} class="btn btn-primary">{hero.ctaPrimary.label}<span class="arrow">→</span></a>
        <a href={hero.ctaSecondary.href} class="btn btn-ghost">{hero.ctaSecondary.label}</a>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ─────────────────────────────────────────────────── -->
  <section id="problem" class="problem">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">The gap</p>
        <h2 class="section-title">{problem.title}</h2>
      </div>
      <ul class="problem-list">
        {problem.points.map((p, i) => (
          <li class="reveal" style={`transition-delay:${i * 0.06}s`}><span class="dot" aria-hidden="true"></span>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── SERVICES ────────────────────────────────────────────────── -->
  <section id="services" class="services">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">What we run</p>
        <h2 class="section-title">A team that owns your top of funnel</h2>
        <p>One dedicated team, coordinated so you get pipeline and judgment, not a management problem.</p>
      </div>
      <div class="svc-grid">
        {services.map((s, i) => (
          <article class="svc reveal" style={`transition-delay:${i * 0.05}s`}>
            <span class="svc-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DIFFERENT ───────────────────────────────────────────────── -->
  <section id="different" class="different">
    <div class="wrap diff-inner">
      <div class="section-head reveal">
        <p class="kicker">Why vsource</p>
        <h2 class="section-title">{different.title}</h2>
      </div>
      <div class="diff-list">
        {different.points.map((d, i) => (
          <div class="diff-row reveal" style={`transition-delay:${i * 0.05}s`}>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTACT + CALCULATOR (clients) ──────────────────────────── -->
  <section id="contact" class="contact">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">For recruiting teams</p>
        <h2 class="section-title">{contact.title}</h2>
        <p>{contact.lede}</p>
      </div>

      <div class="build-grid">
        <!-- Calculator -->
        <div class="calc reveal"
             data-min={pricing.minTeam} data-max={pricing.maxTeam} data-default={pricing.defaultTeam}
             data-base={pricing.base} data-step={pricing.step} data-floor={pricing.floor}
             data-short={pricing.shortMonths} data-long={pricing.longMonths} data-disc={pricing.longDiscount}
             data-cur={pricing.currency}>
          <p class="calc-eyebrow">Estimate your team</p>

          <div class="calc-control">
            <span class="calc-label">Team size</span>
            <div class="stepper">
              <button type="button" class="step" data-step="-1" aria-label="Fewer">−</button>
              <span class="stepper-val"><output id="calcTeam">{pricing.defaultTeam}</output><small>resources</small></span>
              <button type="button" class="step" data-step="1" aria-label="More">+</button>
            </div>
          </div>

          <div class="calc-control">
            <span class="calc-label">Contract</span>
            <div class="seg" role="tablist">
              <button type="button" class="seg-btn is-on" data-term="short">3 months</button>
              <button type="button" class="seg-btn" data-term="long">12 months <em>save 10%</em></button>
            </div>
          </div>

          <div class="calc-out">
            <div class="calc-big"><span id="calcMonthly">$9,600</span> <small>/ month</small></div>
            <div class="calc-sub">
              <span id="calcPerRes">$2,400</span> per resource
              <span class="calc-dot">·</span>
              <span id="calcTotal">$28,800</span> over <span id="calcTerm">3 months</span>
            </div>
          </div>

          <p class="calc-note">{pricing.note}</p>
        </div>

        <!-- Enquiry form -->
        <form class="form card-form reveal" action={forms.endpoint} method="POST">
          <input type="hidden" name="access_key" value={forms.accessKey} />
          <input type="hidden" name="subject" value={contact.subject} />
          <input type="hidden" name="redirect" value={forms.redirect} />
          <input type="hidden" name="team_estimate" id="calcSummary" value="" />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="form-lead" id="calcReadout">A team of 4, 3 months, around $9,600/month.</p>
          <label>{contact.fields.nameLabel}<input type="text" name="name" required /></label>
          <label>{contact.fields.emailLabel}<input type="email" name="email" required /></label>
          <label>{contact.fields.noteLabel}<textarea name="message" rows="3"></textarea></label>
          <button type="submit" class="btn btn-primary">{contact.submit}<span class="arrow">→</span></button>
          <a class="form-mail" href={`mailto:${contact.email}`}>or email {contact.email}</a>
        </form>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ──────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <a href="#top" class="brand footer-brand" aria-label="vsource home">
        <img src="/vsource-mark.svg" alt="" height="30" class="brand-mark" />
        <span class="wordmark">vsource</span>
      </a>
      <div class="footer-legal">
        <p>{footer.tagline}</p>
        <p>{footer.address}</p>
      </div>
      <p class="footer-copy">© {footer.legal} {new Date().getFullYear()}. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const el = document.querySelector('.calc');
      if (!el) return;
      const d = el.dataset;
      const P = {
        min:+d.min, max:+d.max, base:+d.base, step:+d.step, floor:+d.floor,
        short:+d.short, long:+d.long, disc:+d.disc, cur:d.cur,
      };
      let team = +d.default, term = 'short';
      const money = (n) => P.cur + Math.round(n).toLocaleString('en-US');
      const rate = (n) => Math.max(P.floor, P.base - (n - P.min) * P.step);
      const $ = (id) => document.getElementById(id);

      function render() {
        const months = term === 'long' ? P.long : P.short;
        const baseMonthly = team * rate(team);
        const monthly = term === 'long' ? baseMonthly * (1 - P.disc) : baseMonthly;
        const perRes = monthly / team;
        $('calcTeam').textContent = team;
        $('calcMonthly').textContent = money(monthly);
        $('calcPerRes').textContent = money(perRes);
        $('calcTotal').textContent = money(monthly * months);
        $('calcTerm').textContent = months + ' months';
        const summary = `Team of ${team}, ${months} months, ~${money(monthly)}/month (${money(monthly * months)} total).`;
        $('calcReadout').textContent = summary;
        $('calcSummary').value = summary;
        el.querySelectorAll('.step').forEach((b) => {
          const dir = +b.dataset.step;
          b.disabled = (dir < 0 && team <= P.min) || (dir > 0 && team >= P.max);
        });
      }
      el.querySelectorAll('.step').forEach((b) =>
        b.addEventListener('click', () => {
          team = Math.min(P.max, Math.max(P.min, team + (+b.dataset.step)));
          render();
        })
      );
      el.querySelectorAll('.seg-btn').forEach((b) =>
        b.addEventListener('click', () => {
          term = b.dataset.term;
          el.querySelectorAll('.seg-btn').forEach((x) => x.classList.toggle('is-on', x === b));
          render();
        })
      );
      render();
    })();
  </script>
</Base>

<style>
  /* ── NAV ───────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 74px; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; }
  .brand-mark { display: block; }
  .wordmark {
    font-weight: 800; font-size: 1.6rem; letter-spacing: -0.03em;
    color: var(--charcoal); line-height: 1;
  }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-size: 0.92rem; color: var(--slate); font-weight: 600;
    transition: color .2s; letter-spacing: -0.01em;
  }
  .nav-links a:hover { color: var(--orange); }
  .nav-cta { padding: 0.6em 1.1em; font-size: 0.9rem; }
  @media (max-width: 900px) { .nav-links { display: none; } }
  @media (max-width: 520px) { .nav-cta { display: none; } }

  /* ── HERO ──────────────────────────────────────────────── */
  .hero { padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: clamp(4rem, 9vw, 7rem); overflow: hidden; }
  .hero-inner { position: relative; }
  .hero-headline {
    font-size: clamp(2.7rem, 1.3rem + 7vw, 6.4rem);
    margin: 1.4rem 0 0;
  }
  .hero-headline span { display: block; }
  .hero-lede { max-width: 42ch; margin-top: 1.8rem; color: var(--slate); font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem); }
  .hero-cta { display: flex; gap: 0.9rem; margin-top: 2.4rem; flex-wrap: wrap; }

  /* Warm funnel glow, the brand spectrum drawn to a point. */
  .funnel {
    position: absolute; top: -12%; right: -6%;
    width: clamp(300px, 44vw, 660px); aspect-ratio: 1;
    z-index: 0; pointer-events: none;
    background:
      radial-gradient(circle at 60% 30%, rgba(255,193,7,0.55), transparent 42%),
      radial-gradient(circle at 70% 52%, rgba(244,121,32,0.45), transparent 46%),
      radial-gradient(circle at 58% 74%, rgba(236,0,140,0.40), transparent 48%);
    filter: blur(34px);
    opacity: 0.85;
  }
  @media (max-width: 720px) { .funnel { opacity: 0.5; top: auto; bottom: 0; } }

  /* ── PROBLEM ───────────────────────────────────────────── */
  .problem-list { display: grid; gap: 1.25rem; max-width: 64ch; }
  .problem-list li {
    list-style: none; display: flex; gap: 1rem;
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.42; color: var(--ink); font-weight: 500;
    padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);
  }
  .problem-list .dot { width: 10px; height: 10px; background: var(--grad); border-radius: 50%; flex-shrink: 0; margin-top: 0.5em; }

  /* ── SERVICES ──────────────────────────────────────────── */
  .svc-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px; background: var(--line);
    border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
  }
  .svc {
    background: var(--surface); padding: 2rem 1.8rem 2.2rem;
    transition: background .3s, transform .3s; position: relative;
  }
  .svc:hover { background: var(--paper-2); }
  .svc-n {
    font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em;
    background: var(--grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }
  .svc h3 { font-weight: 800; font-size: 1.3rem; margin: 0.9rem 0 0.5rem; letter-spacing: -0.02em; color: var(--charcoal); }
  .svc p { color: var(--slate); font-size: 0.98rem; }

  /* ── DIFFERENT ─────────────────────────────────────────── */
  .different { background: var(--paper-2); border-block: 1px solid var(--line); }
  .diff-inner { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .diff-list { display: grid; gap: 0; }
  .diff-row { padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .diff-row:last-child { border-bottom: 1px solid var(--line); }
  .diff-row h3 { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; color: var(--charcoal); }
  .diff-row p { color: var(--slate); margin-top: 0.35rem; }
  @media (max-width: 800px) { .diff-inner { grid-template-columns: 1fr; } }

  /* ── CONTACT + CALCULATOR ──────────────────────────────── */
  .contact { border-top: 1px solid var(--line); }
  .build-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(1.5rem, 4vw, 2.4rem); align-items: stretch; }
  @media (max-width: 820px) { .build-grid { grid-template-columns: 1fr; } }

  .calc {
    background: var(--surface); border: 1px solid var(--line); border-radius: 18px;
    padding: clamp(1.5rem, 3vw, 2.2rem); display: flex; flex-direction: column; gap: 1.4rem;
    box-shadow: 0 22px 50px -34px rgba(43,45,46,0.4);
  }
  .calc-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--slate); }
  .calc-control { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .calc-label { font-weight: 700; color: var(--charcoal); font-size: 1.02rem; }

  .stepper { display: inline-flex; align-items: center; gap: 0.5rem; }
  .step {
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--paper); color: var(--charcoal); font-size: 1.3rem; line-height: 1; font-weight: 700;
    cursor: pointer; transition: border-color .2s, color .2s, transform .15s;
  }
  .step:hover:not(:disabled) { border-color: var(--orange); color: var(--orange); transform: translateY(-1px); }
  .step:disabled { opacity: 0.35; cursor: not-allowed; }
  .stepper-val { min-width: 4.6rem; text-align: center; display: grid; gap: 1px; }
  .stepper-val output { font-weight: 800; font-size: 1.7rem; color: var(--charcoal); line-height: 1; }
  .stepper-val small { font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mute); }

  .seg { display: inline-flex; background: var(--paper); border: 1px solid var(--line); border-radius: 100px; padding: 4px; }
  .seg-btn {
    border: none; background: transparent; cursor: pointer; border-radius: 100px;
    padding: 0.5em 0.95em; font-family: var(--font); font-weight: 700; font-size: 0.85rem; color: var(--slate);
    display: inline-flex; align-items: center; gap: 0.4em; transition: background .2s, color .2s;
  }
  .seg-btn em { font-style: normal; font-size: 0.7rem; font-weight: 700; color: var(--orange); }
  .seg-btn.is-on { background: var(--charcoal); color: #fff; }
  .seg-btn.is-on em { color: var(--yellow); }

  .calc-out { border-top: 1px solid var(--line); padding-top: 1.2rem; margin-top: auto; }
  .calc-big { font-weight: 800; font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3rem); letter-spacing: -0.03em; color: var(--charcoal); line-height: 1; }
  .calc-big span { background: var(--grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .calc-big small { font-size: 1rem; font-weight: 600; color: var(--slate); letter-spacing: 0; }
  .calc-sub { margin-top: 0.6rem; color: var(--slate); font-size: 0.95rem; }
  .calc-sub span { font-weight: 700; color: var(--charcoal); }
  .calc-dot { color: var(--mute); margin: 0 0.2rem; }
  .calc-note { font-size: 0.78rem; color: var(--mute); line-height: 1.45; }

  .form { display: grid; gap: 1rem; align-content: start; }
  .card-form { background: var(--paper-2); border: 1px solid var(--line); border-radius: 18px; padding: clamp(1.5rem, 3vw, 2.2rem); }
  .form-lead { font-weight: 700; color: var(--charcoal); font-size: 1rem; margin-bottom: 0.2rem; }
  .form label { display: grid; gap: 0.45rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate); }
  .form input, .form textarea {
    font-family: var(--font); font-size: 1rem; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.85em 1em; transition: border-color .2s, box-shadow .2s; resize: vertical;
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(244,121,32,0.12); }
  .form .btn { justify-self: start; margin-top: 0.3rem; }
  .form-mail { font-size: 0.85rem; color: var(--slate); }
  .form-mail:hover { color: var(--orange); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  /* ── FOOTER ────────────────────────────────────────────── */
  .footer { border-top: 1px solid var(--line); padding-block: 3rem; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; }
  .footer-brand .wordmark { font-size: 1.4rem; }
  .footer-legal p { font-size: 0.85rem; color: var(--mute); }
  .footer-copy { font-size: 0.75rem; color: var(--mute); letter-spacing: 0.02em; }
</style>
