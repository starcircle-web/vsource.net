---
import Base from '../layouts/Base.astro';
import { meta, hero, problem, services, different, forms, careers, contact, nav, footer } from '../data/site.js';
---
<Base title={meta.title} description={meta.description}>
  <!-- ── NAV ─────────────────────────────────────────────────────── -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a href="#top" class="brand" aria-label="vsource home">
        <img src="/vsource-logo.png" alt="vsource" height="30" />
      </a>
      <nav class="nav-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#contact" class="btn btn-primary nav-cta">Build your team<span class="arrow">→</span></a>
    </div>
  </header>

  <span id="top"></span>

  <!-- ── HERO ────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="funnel" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="kicker reveal">{hero.kicker}</p>
      <h1 class="display hero-headline">
        {hero.headline.map((line, i) => (
          <span class={"reveal" + (i === hero.headline.length - 1 ? " grad-text" : "")} style={`transition-delay:${0.08 + i * 0.09}s`}>{line}</span>
        ))}
      </h1>
      <p class="hero-lede reveal" style="transition-delay:.42s">{hero.lede}</p>
      <div class="hero-cta reveal" style="transition-delay:.52s">
        <a href={hero.ctaPrimary.href} class="btn btn-primary">{hero.ctaPrimary.label}<span class="arrow">→</span></a>
        <a href={hero.ctaSecondary.href} class="btn btn-ghost">{hero.ctaSecondary.label}</a>
      </div>
    </div>
  </section>

  <!-- ── PROBLEM ─────────────────────────────────────────────────── -->
  <section id="problem" class="problem">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">The gap</p>
        <h2 class="section-title">{problem.title}</h2>
      </div>
      <ul class="problem-list">
        {problem.points.map((p, i) => (
          <li class="reveal" style={`transition-delay:${i * 0.06}s`}><span class="dot" aria-hidden="true"></span>{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── SERVICES ────────────────────────────────────────────────── -->
  <section id="services" class="services">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">What we run</p>
        <h2 class="section-title">A team that owns your top of funnel</h2>
        <p>One dedicated team, coordinated so you get pipeline and judgment, not a management problem.</p>
      </div>
      <div class="svc-grid">
        {services.map((s, i) => (
          <article class="svc reveal" style={`transition-delay:${i * 0.05}s`}>
            <span class="svc-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DIFFERENT ───────────────────────────────────────────────── -->
  <section id="different" class="different">
    <div class="wrap diff-inner">
      <div class="section-head reveal">
        <p class="kicker">Why vsource</p>
        <h2 class="section-title">{different.title}</h2>
      </div>
      <div class="diff-list">
        {different.points.map((d, i) => (
          <div class="diff-row reveal" style={`transition-delay:${i * 0.05}s`}>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTACT (clients) ───────────────────────────────────────── -->
  <section id="contact" class="cta-band contact">
    <div class="wrap cta-inner">
      <div class="cta-copy reveal">
        <p class="kicker">For recruiting teams</p>
        <h2 class="section-title">{contact.title}</h2>
        <p>{contact.lede}</p>
        <div class="contact-meta">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>
      </div>
      <form class="form reveal" action={forms.endpoint} method="POST">
        <input type="hidden" name="access_key" value={forms.accessKey} />
        <input type="hidden" name="subject" value={contact.subject} />
        <input type="hidden" name="redirect" value={forms.redirect} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>{contact.fields.nameLabel}<input type="text" name="name" required /></label>
        <label>{contact.fields.emailLabel}<input type="email" name="email" required /></label>
        <label>{contact.fields.noteLabel}<textarea name="message" rows="3"></textarea></label>
        <button type="submit" class="btn btn-primary">{contact.submit}<span class="arrow">→</span></button>
      </form>
    </div>
  </section>

  <!-- ── CAREERS ─────────────────────────────────────────────────── -->
  <section id="careers" class="cta-band careers">
    <div class="wrap cta-inner">
      <div class="cta-copy reveal">
        <p class="kicker">For sourcers</p>
        <h2 class="section-title">{careers.title}</h2>
        <p>{careers.lede}</p>
      </div>
      <form class="form reveal" action={forms.endpoint} method="POST">
        <input type="hidden" name="access_key" value={forms.accessKey} />
        <input type="hidden" name="subject" value={careers.subject} />
        <input type="hidden" name="redirect" value={forms.redirect} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>{careers.fields.nameLabel}<input type="text" name="name" required /></label>
        <label>{careers.fields.emailLabel}<input type="email" name="email" required /></label>
        <label>{careers.fields.noteLabel}<textarea name="message" rows="3"></textarea></label>
        <button type="submit" class="btn btn-ghost">{careers.submit}<span class="arrow">→</span></button>
      </form>
    </div>
  </section>

  <!-- ── FOOTER ──────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <img src="/vsource-logo.png" alt="vsource" height="26" class="footer-mark" />
      <div class="footer-legal">
        <p>{footer.tagline}</p>
        <p>{footer.address}</p>
      </div>
      <p class="footer-copy">© {footer.legal} {new Date().getFullYear()}. All rights reserved.</p>
    </div>
  </footer>
</Base>

<style>
  /* ── NAV ───────────────────────────────────────────────── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 74px; }
  .brand img { display: block; }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    font-size: 0.92rem; color: var(--slate); font-weight: 600;
    transition: color .2s; letter-spacing: -0.01em;
  }
  .nav-links a:hover { color: var(--orange); }
  .nav-cta { padding: 0.6em 1.1em; font-size: 0.9rem; }
  @media (max-width: 900px) { .nav-links { display: none; } }
  @media (max-width: 520px) { .nav-cta { display: none; } }

  /* ── HERO ──────────────────────────────────────────────── */
  .hero { padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: clamp(4rem, 9vw, 7rem); overflow: hidden; }
  .hero-inner { position: relative; }
  .hero-headline {
    font-size: clamp(2.7rem, 1.3rem + 7vw, 6.4rem);
    margin: 1.4rem 0 0;
  }
  .hero-headline span { display: block; }
  .hero-lede { max-width: 42ch; margin-top: 1.8rem; color: var(--slate); font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem); }
  .hero-cta { display: flex; gap: 0.9rem; margin-top: 2.4rem; flex-wrap: wrap; }

  /* Warm funnel glow, the brand spectrum drawn to a point. */
  .funnel {
    position: absolute; top: -12%; right: -6%;
    width: clamp(300px, 44vw, 660px); aspect-ratio: 1;
    z-index: 0; pointer-events: none;
    background:
      radial-gradient(circle at 60% 30%, rgba(255,193,7,0.55), transparent 42%),
      radial-gradient(circle at 70% 52%, rgba(244,121,32,0.45), transparent 46%),
      radial-gradient(circle at 58% 74%, rgba(236,0,140,0.40), transparent 48%);
    filter: blur(34px);
    opacity: 0.85;
  }
  @media (max-width: 720px) { .funnel { opacity: 0.5; top: auto; bottom: 0; } }

  /* ── PROBLEM ───────────────────────────────────────────── */
  .problem-list { display: grid; gap: 1.25rem; max-width: 64ch; }
  .problem-list li {
    list-style: none; display: flex; gap: 1rem;
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.42; color: var(--ink); font-weight: 500;
    padding-bottom: 1.25rem; border-bottom: 1px solid var(--line);
  }
  .problem-list .dot { width: 10px; height: 10px; background: var(--grad); border-radius: 50%; flex-shrink: 0; margin-top: 0.5em; }

  /* ── SERVICES ──────────────────────────────────────────── */
  .svc-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px; background: var(--line);
    border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
  }
  .svc {
    background: var(--surface); padding: 2rem 1.8rem 2.2rem;
    transition: background .3s, transform .3s; position: relative;
  }
  .svc:hover { background: var(--paper-2); }
  .svc-n {
    font-weight: 800; font-size: 0.8rem; letter-spacing: 0.06em;
    background: var(--grad); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }
  .svc h3 { font-weight: 800; font-size: 1.3rem; margin: 0.9rem 0 0.5rem; letter-spacing: -0.02em; color: var(--charcoal); }
  .svc p { color: var(--slate); font-size: 0.98rem; }

  /* ── DIFFERENT ─────────────────────────────────────────── */
  .different { background: var(--paper-2); border-block: 1px solid var(--line); }
  .diff-inner { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .diff-list { display: grid; gap: 0; }
  .diff-row { padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .diff-row:last-child { border-bottom: 1px solid var(--line); }
  .diff-row h3 { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; color: var(--charcoal); }
  .diff-row p { color: var(--slate); margin-top: 0.35rem; }
  @media (max-width: 800px) { .diff-inner { grid-template-columns: 1fr; } }

  /* ── CTA BANDS (contact / careers) ─────────────────────── */
  .cta-band { border-top: 1px solid var(--line); }
  .cta-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .cta-copy p { color: var(--slate); margin-top: 1rem; max-width: 42ch; }
  .contact-meta { display: flex; gap: 1.5rem; margin-top: 1.6rem; }
  .contact-meta a { font-weight: 700; font-size: 0.95rem; color: var(--orange); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: border-color .2s; }
  .contact-meta a:hover { border-color: var(--orange); }
  .form { display: grid; gap: 1rem; }
  .form label { display: grid; gap: 0.45rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate); }
  .form input, .form textarea {
    font-family: var(--font); font-size: 1rem; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
    padding: 0.85em 1em; transition: border-color .2s, box-shadow .2s; resize: vertical;
  }
  .form input:focus, .form textarea:focus { outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(244,121,32,0.12); }
  .form .btn { justify-self: start; margin-top: 0.3rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .careers { background: var(--paper-2); }
  @media (max-width: 760px) { .cta-inner { grid-template-columns: 1fr; } }

  /* ── FOOTER ────────────────────────────────────────────── */
  .footer { border-top: 1px solid var(--line); padding-block: 3rem; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; align-items: center; justify-content: space-between; }
  .footer-mark { opacity: 0.92; }
  .footer-legal p { font-size: 0.85rem; color: var(--mute); }
  .footer-copy { font-size: 0.75rem; color: var(--mute); letter-spacing: 0.02em; }
</style>
